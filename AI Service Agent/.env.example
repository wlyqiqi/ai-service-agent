# OpenAI-compatible credentials (field names keep ARK_* for historical reasons).
# If ARK_BASE_URL is SiliconFlow (api.siliconflow.cn), ARK_API_KEY must be a SiliconFlow sk- key.
# Do not pair a Volcengine ark- token with the SiliconFlow base URL (causes 401 Token is invalid).
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=deepseek-v4-flash
# Optional dedicated router model name (defaults to ARK_MODEL).
# ROUTER_MODEL=

# Route Intent Router v2：默认关闭；开启后与旧 Router 并存，可通过关闭 flag 回滚。
JEV_ROUTE_INTENT_ENABLED=false

# Async LLM-boundary node TimeoutPolicy (seconds). Must be > model HTTP timeouts below.
JEV_NODE_TIMEOUT_SECONDS=3.0
ROUTER_NODE_TIMEOUT_SECONDS=6.0
LLM_NODE_TIMEOUT_SECONDS=12.0

# Model HTTP timeouts (seconds); must be < corresponding node TimeoutPolicy.
ROUTER_MODEL_TIMEOUT_SECONDS=5
LLM_MODEL_TIMEOUT_SECONDS=10

# Per-profile sampling / max output tokens (set on ChatOpenAI instances, not hooks).
ROUTER_TEMPERATURE=0
SELECT_TEMPERATURE=0
READ_TEMPERATURE=0.3
FALLBACK_TEMPERATURE=0.3
ROUTER_MAX_TOKENS=256
SELECT_MAX_TOKENS=512
READ_MAX_TOKENS=1024
FALLBACK_MAX_TOKENS=512

# Context input budgets (trim_messages / ContextBudgetMiddleware).
ROUTER_TOTAL_INPUT_MAX_TOKENS=800
FALLBACK_TOTAL_INPUT_MAX_TOKENS=800
READ_TOTAL_INPUT_MAX_TOKENS=2000
SELECT_TOTAL_INPUT_MAX_TOKENS=1200

# Authentication. The code default is ON (Settings.auth_enabled=True) even if this
# line is deleted. Business, session, and approval APIs then require a Bearer JWT,
# and the server refuses to start without JWT_SECRET.
#
# Local development and pytest must opt out explicitly:
#   AUTH_ENABLED=false
# Pytest sets that in tests/conftest.py. Do not run a shared deployment with auth off.
#
# With auth off, approve/reject still reject an empty or "anonymous" actor and a
# requester deciding their own request. Send header X-Approver-User-Id with a
# different user id (local/test only; ignored when AUTH_ENABLED=true).
AUTH_ENABLED=true
# Required when AUTH_ENABLED=true. Use a long random secret (32+ bytes).
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# LangSmith 观测（默认关闭；tracing=true 时自动上报全链路 trace，dashboard 在 LangSmith UI）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Legacy / optional ARK fallback (used only when ROUTER_* / LLM_* unset).
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-flash

# Router primary + on-error fallback (OpenAI-compatible). Credentials: ROUTER_* → LLM_* → ARK_*.
ROUTER_MODEL=Qwen/Qwen3.6-35B-A3B
ROUTER_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# ROUTER_BASE_URL=https://api.siliconflow.cn/v1
# ROUTER_API_KEY=

# Non-router LLM nodes (read / select / fallback). Prefer SiliconFlow when Ark is over quota.
# Falls back to ARK_* when unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Optional: full Authorization header for OfficeACE / Huawei gateways (e.g. "Basic …").
# LLM_AUTH_HEADER=

# DeepEval Read quality-plane judge (prefer separate from SUT). Required for clean separation:
# DEEPEVAL_JUDGE_MODEL / BASE_URL / API_KEY (+ AUTH_HEADER for OfficeACE).
# Falls back to LLM_* only if incomplete (emits warning).
# Judge sends enable_thinking=true + reasoning_effort=high via LocalModel generation_kwargs.
# Runtime LLM_* / ROUTER_* stay enable_thinking=false via config._openai_compat_model.
#
# Example: OfficeACE deepseek-flash judge (while runtime stays on SiliconFlow):
# DEEPEVAL_JUDGE_BASE_URL=https://modelgw-0004.officeace.cn-southwest-2.huaweicloud-agentarts.com/v2
# DEEPEVAL_JUDGE_MODEL=deepseek-v4-flash
# DEEPEVAL_JUDGE_API_KEY=
# DEEPEVAL_JUDGE_AUTH_HEADER=Basic ...
DEEPEVAL_JUDGE_API_KEY=
DEEPEVAL_JUDGE_BASE_URL=
DEEPEVAL_JUDGE_MODEL=
# DEEPEVAL_JUDGE_AUTH_HEADER=

# Route Intent Router v2：默认关闭；开启后与旧 Router 并存，可通过关闭 flag 回滚。
JEV_ROUTE_INTENT_ENABLED=false

# Async LLM-boundary node TimeoutPolicy (seconds). Must be > model HTTP timeouts below.
JEV_NODE_TIMEOUT_SECONDS=3.0
ROUTER_NODE_TIMEOUT_SECONDS=6.0
LLM_NODE_TIMEOUT_SECONDS=12.0

# Model HTTP timeouts (seconds); must be < corresponding node TimeoutPolicy.
ROUTER_MODEL_TIMEOUT_SECONDS=5
LLM_MODEL_TIMEOUT_SECONDS=10

# Per-profile sampling / max output tokens (set on ChatOpenAI instances, not hooks).
ROUTER_TEMPERATURE=0
SELECT_TEMPERATURE=0
READ_TEMPERATURE=0.3
FALLBACK_TEMPERATURE=0.3
ROUTER_MAX_TOKENS=256
SELECT_MAX_TOKENS=512
READ_MAX_TOKENS=1024
FALLBACK_MAX_TOKENS=512

# Context input budgets (trim_messages / ContextBudgetMiddleware).
ROUTER_TOTAL_INPUT_MAX_TOKENS=800
FALLBACK_TOTAL_INPUT_MAX_TOKENS=800
READ_TOTAL_INPUT_MAX_TOKENS=2000
SELECT_TOTAL_INPUT_MAX_TOKENS=1200

AUTH_ENABLED=false
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
# Seat HTTP badge for HighRisk approve/reject (X-Seat-Approval-Credential + X-Seat-Actor-Id).
# Required for human approve/reject; leave empty to fail-closed (403). simulate_approval still works.
SEAT_APPROVAL_SECRET=
# 审批卡按钮的决策链接（ADR-0006）。签名密钥缺省从 SEAT_APPROVAL_SECRET 派生；
# 两者都为空时链接一律判无效（fail-closed），卡片仍可读但点不动。
APPROVAL_LINK_SECRET=
# 卡片按钮指向的 Runtime 对外地址；留空按 AI_SERVICE_PORT 推 http://127.0.0.1:<port>。
# 生产必须配成坐席浏览器可达的地址（否则按钮会指向 127.0.0.1 而点不开）。
APPROVAL_LINK_BASE_URL=
# 坐席端注入脚本会在 Chatwoot 页面里 fetch 决策端点（跨源）。逗号分隔；
# 留空用 CHATWOOT_BASE_URL（自动补 localhost/127.0.0.1 变体）。
APPROVAL_LINK_CORS_ORIGINS=

# LangSmith 观测（默认关闭；tracing=true 时自动上报全链路 trace，dashboard 在 LangSmith UI）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# #151 后台 idle thread 回收（0=关闭；生产建议 1800）
# THREAD_REAPER_INTERVAL_SECONDS=1800
# THREAD_REAPER_BATCH_SIZE=50

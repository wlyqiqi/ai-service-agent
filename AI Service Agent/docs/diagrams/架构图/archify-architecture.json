  "cards": [
    {
      "dot": "cyan",
      "title": "入口",
      "items": [
        "Chatwoot Widget 是 C 端唯一对话壳",
        "AgentBot Adapter 投影 interrupt，并把表单提交转成 Command(resume)",
        "human 车道停在 Conversation Runtime，不 invoke 总图"
      ]
    },
    {
      "dot": "emerald",
      "title": "编排",
      "items": [
        "Guard 与 Router 并行，Policy 按 route_intent 派生子图与 allowed_tools",
        "ReadGraph 走 ReAct；MutationGraph 用 Form Interrupt，确认后才写库",
        "HighRisk 由坐席旁路审批；Fallback 负责兜底与转人工信号"
      ]
    },
    {
      "dot": "rose",
      "title": "状态与模型",
      "items": [
        "AsyncSqliteSaver 按 thread_id 保存图状态",
        "订单读写走 SQLiteOrderRepository，与 checkpoint 分开",
        "ARK 提供 Router、Read 与写路径的模型调用"
      ]
    }
  ]

  "cards": [
    {
      "dot": "cyan",
      "title": "入口层分支",
      "items": [
        "mode=human → 不进 Graph，直接写 MessageStore + Chatwoot",
        "detect_handoff_intent() 命中 → HandoffService.request_handoff() → 原子切换 mode",
        "pending approval → yield approval_required，不 resume 不新起 run"
      ]
    },
    {
      "dot": "emerald",
      "title": "LangGraph 并行",
      "items": [
        "START 同时分发到 guard 与 router_llm（并行节点）",
        "policy_gate 为确定性 join 点，按 route_intent → PolicyDecision 派生",
        "guard fail → safety_final（不进子图）"
      ]
    },
    {
      "dot": "rose",
      "title": "响应安全",
      "items": [
        "done 事件触发前实时复检 conversation_mode",
        "已被切走则丢弃回复且不持久化",
        "MessageStore 为会话消息唯一真相源"
      ]
    }
  ]
